{
	"name": "buang-github-app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite build --config app/vite.config.ts --watch & tsx watch src/index.ts",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build --output-dir app/storybook-static",
		"build:app": "vite build --config app/vite.config.ts",
		"build:server": "tsc -p tsconfig.build.json",
		"build": "pnpm build:app && pnpm build:server",
		"start": "node dist/index.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"format": "prettier --write .",
		"migrate": "migrate -source file://$(pwd)/migrations/ -database $DATABASE_URL up",
		"migrate:down": "migrate -source file://$(pwd)/migrations/ -database $DATABASE_URL down"
	},
	"dependencies": {
		"@hono/node-server": "^1",
		"@hono/oidc-auth": "^1",
		"@sentry/node": "^8",
		"austenite": "^0.14",
		"bcrypt": "^5",
		"hono": "^4",
		"pg": "^8",
		"probot": "^13"
	},
	"devDependencies": {
		"@eslint/js": "^9",
		"@hookform/resolvers": "^3",
		"@radix-ui/react-label": "^2",
		"@radix-ui/react-select": "^2",
		"@radix-ui/react-slot": "^1",
		"@radix-ui/react-switch": "^1",
		"@storybook/addon-essentials": "^8.6.14",
		"@storybook/react": "^8.6.18",
		"@storybook/react-vite": "^8.6.18",
		"@tailwindcss/vite": "^4",
		"@tanstack/react-query": "^5",
		"@types/bcrypt": "^5",
		"@types/node": "^22",
		"@types/pg": "^8",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^4",
		"class-variance-authority": "^0",
		"clsx": "^2",
		"eslint": "^9",
		"eslint-plugin-import": "^2",
		"lucide-react": "^0",
		"prettier": "^3",
		"prettier-plugin-organize-imports": "^4",
		"react": "^19",
		"react-dom": "^19",
		"react-hook-form": "^7",
		"react-router-dom": "^7",
		"storybook": "^8.6.18",
		"tailwind-merge": "^2",
		"tailwindcss": "^4",
		"tsx": "^4",
		"typescript": "^5",
		"typescript-eslint": "^8",
		"vite": "^6",
		"vitest": "^2",
		"yup": "^1"
	}
}
